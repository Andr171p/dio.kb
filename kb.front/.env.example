# Базовые адреса API. В dev запросы идут через proxy Vite (см. vite.config.ts),
# в production можно указать абсолютные URL — они автоматически попадут в CSP connect-src.
VITE_AUTH_API_URL=/auth-api
VITE_KB_API_URL=/kb-api

# Куда проксировать запросы в dev-режиме
AUTH_API_TARGET=http://localhost:8001
KB_API_TARGET=http://localhost:8010

# Хранилище Media Service, куда браузер загружает файлы по presigned URL
VITE_MEDIA_STORAGE_URL=https://storage.yandexcloud.net

# Фронт DIOS: ссылки на заявки и возврат в DIOS
VITE_DIOS_URL=http://localhost:3001

# Сервисы экосистемы DIOS (через запятую): ссылки на них открываются без предупреждения
VITE_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Справка по базе знаний: ссылка «Помощь» в шапке. Пусто — ссылка скрыта
VITE_HELP_URL=
